<Window x:Class="AppTemplate.Help.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource StrHelpTitle}" Height="550" Width="650"
        MinHeight="400" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/ThemeDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel & Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource StrHelpHeader}"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="{DynamicResource StrHelpSubHeader}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Inhaltsbereich mit ScrollBar -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <StackPanel>
                    <!-- Sektion 1 -->
                    <TextBlock Text="{DynamicResource StrHelpSection1Title}"
                               FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource StrHelpSection1Text}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>

                    <!-- Sektion 2 -->
                    <TextBlock Text="{DynamicResource StrHelpSection2Title}"
                               FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource StrHelpSection2Text}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>

                    <!-- Sektion 3 -->
                    <TextBlock Text="{DynamicResource StrHelpSection3Title}"
                               FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource StrHelpSection3Text}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>

                    <!-- Sektion 4 -->
                    <TextBlock Text="{DynamicResource StrHelpSection4Title}"
                               FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource StrHelpSection4Text}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>

                    <!-- Sektion 5 -->
                    <TextBlock Text="{DynamicResource StrHelpSection5Title}"
                               FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource StrHelpSection5Text}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Schließen Button -->
        <Button Grid.Row="2" Content="{DynamicResource BtnClose}"
                HorizontalAlignment="Right" Width="100" Margin="0,16,0,0"
                Click="BtnClose_Click" Style="{StaticResource PrimaryButton}"/>
    </Grid>
</Window>