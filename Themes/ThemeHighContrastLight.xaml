<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderColor" Color="#000000"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#000000"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#000000"/>

    <!-- Option A: Tiefes Marineblau mit weißer Schrift (Sehr sauber für Light-Mode) -->
    <SolidColorBrush x:Key="PrimaryBlue" Color="#000000"/>
    <SolidColorBrush x:Key="PrimaryButtonForeground" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SelectionOverlay" Color="#000000" Opacity="0.35"/>
    <SolidColorBrush x:Key="RowHighlightForeground" Color="#FFFFFF"/>

</ResourceDictionary>