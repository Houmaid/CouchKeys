<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Hintergründe & Container -->
    <SolidColorBrush x:Key="AppBackground" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="CardBackground" Color="{x:Static SystemColors.ControlColor}"/>
    <SolidColorBrush x:Key="BorderColor" Color="{x:Static SystemColors.ActiveBorderColor}"/>

    <!-- Texte -->
    <SolidColorBrush x:Key="TextPrimary" Color="{x:Static SystemColors.WindowTextColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{x:Static SystemColors.GrayTextColor}"/>

    <!-- Akzentfarben & Eingabefelder -->
    <SolidColorBrush x:Key="PrimaryBlue" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#005A9E"/>
    <SolidColorBrush x:Key="PrimaryPressed" Color="#003D6B"/>
    <SolidColorBrush x:Key="InputBackground" Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="PrimaryButtonForeground" Color="{x:Static SystemColors.HighlightTextColor}"/>

</ResourceDictionary>