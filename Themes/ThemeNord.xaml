<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Hintergründe & Container -->
    <SolidColorBrush x:Key="AppBackground" Color="#2E3440"/>
    <SolidColorBrush x:Key="CardBackground" Color="#3B4252"/>
    <SolidColorBrush x:Key="BorderColor" Color="#88C0D0"/>

    <!-- Texte -->
    <SolidColorBrush x:Key="TextPrimary" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#E5E9F0"/>

    <!-- Akzentfarben & Eingabefelder -->
    <SolidColorBrush x:Key="PrimaryBlue" Color="#88C0D0"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#8FBCBB"/>
    <SolidColorBrush x:Key="PrimaryPressed" Color="#81A1C1"/>
    <SolidColorBrush x:Key="InputBackground" Color="#434C5E"/>
    <SolidColorBrush x:Key="PrimaryButtonForeground" Color="#2E3440"/>

</ResourceDictionary>