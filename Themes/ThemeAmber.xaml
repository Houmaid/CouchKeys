<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Hintergründe & Container -->
    <SolidColorBrush x:Key="AppBackground" Color="#221508"/>
    <SolidColorBrush x:Key="CardBackground" Color="#38230F"/>
    <SolidColorBrush x:Key="BorderColor" Color="#F59E0B"/>

    <!-- Texte -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FDE68A"/>

    <!-- Akzentfarben & Eingabefelder -->
    <SolidColorBrush x:Key="PrimaryBlue" Color="#F59E0B"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#FBBF24"/>
    <SolidColorBrush x:Key="PrimaryPressed" Color="#D97706"/>
    <SolidColorBrush x:Key="InputBackground" Color="#4D3117"/>
    <SolidColorBrush x:Key="PrimaryButtonForeground" Color="#221508"/>

</ResourceDictionary>