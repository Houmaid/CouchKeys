<Window x:Class="AppTemplate.PayPal.PayPalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource StrPayPalTitle}" Height="320" Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,20,0,10">
            <TextBlock Text="{DynamicResource StrSupportProject}"
                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="{DynamicResource StrSupportSubtext}"
                       FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Hauptbereich ohne Border-Rahmen -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="{DynamicResource StrOpenPayPal}"
                    Click="BtnOpenPayPal_Click"
                    Width="280" Height="42"
                    Style="{StaticResource PrimaryButton}"
                    Foreground="#000000"
                    FontWeight="Bold"/>
        </StackPanel>

        <!-- Unterer Schließen-Button -->
        <Button Grid.Row="2" Content="{DynamicResource BtnClose}"
                HorizontalAlignment="Right" Width="100" Margin="0,10,0,0"
                Click="BtnClose_Click"/>
    </Grid>
</Window>