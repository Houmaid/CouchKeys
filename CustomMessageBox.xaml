<Window x:Class="CouchKeys.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Height="220" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

	<Border Background="{DynamicResource AppBackground}"
            BorderBrush="{DynamicResource TextSecondary}" BorderThickness="1" CornerRadius="8">
		<Grid Margin="16">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- Eigener Fenstertitel -->
			<TextBlock x:Name="TxtTitle" Grid.Row="0" FontWeight="Bold" FontSize="16"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

			<!-- Nachrichtentext -->
			<TextBlock x:Name="TxtMessage" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14"
                       Foreground="{DynamicResource TextPrimary}"/>

			<!-- Buttons -->
			<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
				<Button x:Name="BtnYes" Content="Ja" Width="80" Margin="5" Click="BtnYes_Click" Style="{StaticResource PrimaryButton}" Visibility="Collapsed"/>
				<Button x:Name="BtnNo" Content="Nein" Width="80" Margin="5" Click="BtnNo_Click" Style="{StaticResource PrimaryButton}" Visibility="Collapsed"/>
				<Button x:Name="BtnCancel" Content="Abbrechen" Width="90" Margin="5" Click="BtnCancel_Click" Style="{StaticResource PrimaryButton}" Visibility="Collapsed"/>
				<Button x:Name="BtnOk" Content="OK" Width="80" Margin="5" Click="BtnOk_Click" Style="{StaticResource PrimaryButton}" Visibility="Collapsed"/>
			</StackPanel>
		</Grid>
	</Border>
</Window>